# ── Environment Variables for Render (Production) & Local (Development) ──
PORT=5000
NODE_ENV=production
MONGODB_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/mentore_lms?retryWrites=true&w=majority
JWT_SECRET=generate_a_random_32_character_string_here
JWT_EXPIRES_IN=1d

# Frontend URL (For Render: set to your Vercel URL e.g. https://your-app.vercel.app)
CLIENT_URL=https://your-app.vercel.app

# Lead Trainer Seed Configuration (Set your initial admin credentials)
TRAINER_FIRST_NAME=Admin
TRAINER_LAST_NAME=Trainer
TRAINER_EMAIL=trainer@yourdomain.com
TRAINER_PASSWORD=YourStrongPassword123!

# Single active device session enforcement
ALLOW_MULTIPLE_SESSIONS=false

# Storage & Assets
STORAGE_DRIVER=local
HLS_STORAGE_PATH=./storage/hls
MAX_NOTE_SIZE_MB=15
